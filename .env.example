# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-api-key

# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot)
ALLOWED_USER_IDS=123456789

# Model + behavior
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_EFFORT=medium

# Postgres — on Railway, add the Postgres plugin and it injects this automatically.
# Locally, point it at any Postgres instance (or run one via `docker run postgres`).
DATABASE_URL=postgresql://user:password@localhost:5432/claudefortelegram

# Ephemeral in-memory conversation context (never written to Postgres)
MAX_SESSION_MESSAGES=40
SESSION_IDLE_TIMEOUT_MINUTES=180

# Optional: path to a text file with a custom system prompt
SYSTEM_PROMPT_PATH=
