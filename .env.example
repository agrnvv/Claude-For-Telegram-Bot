# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-api-key

# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot)
ALLOWED_USER_IDS=123456789

# Model + behavior
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_EFFORT=high
MAX_HISTORY_MESSAGES=40

# Optional: path to a text file with a custom system prompt
SYSTEM_PROMPT_PATH=
